{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-mingw",
            "displayName": "Windows (MinGW + Ninja)",
            "description": "Build with a MinGW Qt kit. Set QT_ROOT_DIR and put the matching MinGW and Ninja on PATH.",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/windows-mingw",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
            }
        },
        {
            "name": "windows-mingw-release",
            "displayName": "Windows (MinGW + Ninja, Release)",
            "description": "Release build for packaging: optimized, no debug symbols. Used to produce the NSIS installer via CPack.",
            "inherits": "windows-mingw",
            "binaryDir": "${sourceDir}/build/windows-mingw-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows (Visual Studio 2022)",
            "description": "Build with Visual Studio 2022 and its matching MSVC Qt kit. Set QT_ROOT_DIR first.",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-msvc",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "TRACEVIEW_BUILD_TESTS": "ON",
                "TRACEVIEW_BUILD_TOOLS": "ON"
            }
        },
        {
            "name": "linux-ninja",
            "displayName": "Linux (Ninja)",
            "description": "Build with the system compiler and Qt installation. QT_ROOT_DIR is optional for a non-system Qt.",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/linux-ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
            }
        },
        {
            "name": "linux-ninja-release",
            "displayName": "Linux (Ninja, Release)",
            "description": "Release build for packaging: optimized, no debug symbols. Used to produce the AppImage via scripts/build_linux_appimage.sh.",
            "inherits": "linux-ninja",
            "binaryDir": "${sourceDir}/build/linux-ninja-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "android-arm64",
            "displayName": "Android (arm64-v8a)",
            "description": "Cross-compiles for Android with a Qt for Android kit -- UNVALIDATED, see docs/ANDROID_BUILD.md before using. Requires ANDROID_SDK_ROOT, ANDROID_NDK_ROOT, QT_ANDROID_ROOT_DIR (the android_arm64_v8a Qt kit) and QT_ROOT_DIR (a matching desktop Qt kit, for host moc/rcc/androiddeployqt) set first.",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/android-arm64",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{QT_ANDROID_ROOT_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-28",
                "ANDROID_SDK_ROOT": "$env{ANDROID_SDK_ROOT}",
                "CMAKE_PREFIX_PATH": "$env{QT_ANDROID_ROOT_DIR}",
                "QT_HOST_PATH": "$env{QT_ROOT_DIR}",
                "QT_ANDROID_BUILD_ALL_ABIS": "OFF",
                "TRACEVIEW_ENABLE_SERIAL": "ON",
                "TRACEVIEW_ENABLE_USB_HID": "OFF",
                "TRACEVIEW_ENABLE_TCP": "ON",
                "TRACEVIEW_ENABLE_BLE": "ON",
                "TRACEVIEW_BUILD_TESTS": "OFF",
                "TRACEVIEW_BUILD_TOOLS": "OFF"
            }
        },
        {
            "name": "android-arm64-release",
            "displayName": "Android (arm64-v8a, Release)",
            "description": "Release build for packaging -- see android-arm64's own description first. Produces an UNSIGNED APK; release.yml signs it with the project keystore (see docs/ANDROID_BUILD.md, Release signing).",
            "inherits": "android-arm64",
            "binaryDir": "${sourceDir}/build/android-arm64-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-mingw",
            "configurePreset": "windows-mingw",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-msvc",
            "configurePreset": "windows-msvc",
            "configuration": "Debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-ninja",
            "configurePreset": "linux-ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows-mingw-release",
            "configurePreset": "windows-mingw-release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-ninja-release",
            "configurePreset": "linux-ninja-release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "android-arm64",
            "configurePreset": "android-arm64"
        },
        {
            "name": "android-arm64-release",
            "configurePreset": "android-arm64-release"
        }
    ],
    "testPresets": [
        {
            "name": "windows-mingw",
            "configurePreset": "windows-mingw",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-msvc",
            "configurePreset": "windows-msvc",
            "configuration": "Debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-ninja",
            "configurePreset": "linux-ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
