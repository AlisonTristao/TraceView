# Build output
build/
build-*/
.flatpak-builder/
flatpak-repo/
out/
cmake-build-*/

# CMake
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
_deps/
CMakeUserPresets.json

# Qt
*.autosave
*.pro.user
*.pro.user.*
moc_*.cpp
ui_*.h
qrc_*.cpp

# Qt Creator
CMakeLists.txt.user
CMakeLists.txt.user.*

# Dev script virtual envs (see scripts/_bootstrap.py)
scripts/.venv-*/
__pycache__/
*.pyc

# CTest output
Testing/

# IDE
.vs/
.vscode/
!.vscode/extensions.json
.idea/
*.suo

# OS
.DS_Store
Thumbs.db

# Compiled binaries
*.o
*.obj
*.exe
*.dll
*.so
*.dylib

# Vendored prebuilt OpenSSL for Android (see CMakeLists.txt's
# QT_ANDROID_EXTRA_LIBS comment) -- third-party binaries we track on
# purpose, not build output the *.so rule above means to catch.
!android/openssl/**/*.so

# Android release signing keys -- never commit them (see
# docs/ANDROID_BUILD.md, "Release signing").
*.jks
*.keystore
