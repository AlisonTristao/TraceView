#pragma once
// Generated by CMake from TRACEVIEW_DEFAULT_ADMIN_USER/_PASSWORD -- do not
// edit, and do not commit the generated copy. Keeping the values here
// rather than in usermodemanager.cpp keeps the tracked source free of a
// credential and lets a deployment set its own at configure time without
// touching code.
constexpr char kDefaultAdminUsername[] = "@TRACEVIEW_DEFAULT_ADMIN_USER@";
constexpr char kDefaultAdminPassword[] = "@TRACEVIEW_DEFAULT_ADMIN_PASSWORD@";
// Whether the build left the password at its shipped placeholder -- drives
// the warning in MainWindow::updateAccessMenu(). Decided by CMake (see the
// root CMakeLists.txt), which can compare the strings properly; doing it
// here would mean comparing contents at compile time, and the tempting
// sizeof() shortcut only compares lengths.
constexpr bool kDefaultAdminPasswordIsPlaceholder =
    @TRACEVIEW_DEFAULT_ADMIN_PASSWORD_IS_PLACEHOLDER@;
